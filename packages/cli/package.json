{
  "name": "baretta",
  "version": "1.0.0",
  "description": "Baretta Starter: generador modular de proyectos Next.js de Estudio Baretta, optimizado para agentes de IA.",
  "type": "module",
  "license": "MIT",
  "author": "Estudio Baretta",
  "bin": {
    "baretta": "bin/baretta.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "compatibility",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "keywords": [
    "nextjs",
    "starter",
    "generator",
    "scaffold",
    "clerk",
    "convex",
    "supabase",
    "prisma",
    "mercadopago",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  }
}
