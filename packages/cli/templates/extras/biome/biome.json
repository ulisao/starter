{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**/*.{ts,tsx,js,mjs,cjs,json,jsonc,css}", "!**/.next", "!src/generated", "!convex/_generated", "!next-env.d.ts", "!baretta.config.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "css": { "parser": { "tailwindDirectives": true } }
}
