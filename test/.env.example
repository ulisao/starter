# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.

# ── base ──────────────────────────────────────────────
# URL pública de la aplicación (sin barra final). Se usa para URLs absolutas y redirecciones.
# Dónde obtenerla: En desarrollo: http://localhost:3000. En producción: tu dominio (ej: https://miapp.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── backend-convex ────────────────────────────────────
# URL de tu deployment de Convex. Es pública: el navegador la usa para conectarse.
# Dónde obtenerla: La escribe `npx convex dev` en .env.local. También: Convex Dashboard → Settings → URL & Deploy Key.
NEXT_PUBLIC_CONVEX_URL=https://tu-deployment.convex.cloud

# Deployment de desarrollo al que apunta la CLI de Convex (no la lee la aplicación en runtime).
# Dónde obtenerla: La escribe `npx convex dev` en .env.local al crear o enlazar el proyecto.
CONVEX_DEPLOYMENT=dev:tu-deployment

# ── auth-clerk-convex ─────────────────────────────────
# Variable del deployment de Convex (npx convex env set), NO se lee desde .env.local. Dominio emisor de los tokens de Clerk (Frontend API URL).
# Dónde obtenerla: Clerk Dashboard → Configure → Developers → API keys (Frontend API URL), tras activar la integración con Convex.
CLERK_JWT_ISSUER_DOMAIN=https://tu-instancia.clerk.accounts.dev

# ── auth-clerk ────────────────────────────────────────
# Clave pública (publishable key) de tu aplicación en Clerk.
# Dónde obtenerla: Clerk Dashboard → tu aplicación → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clave secreta de Clerk, usada por el servidor para verificar sesiones. [SECRETA: solo servidor]
# Dónde obtenerla: Clerk Dashboard → tu aplicación → API keys.
CLERK_SECRET_KEY=sk_test_...

# Ruta de tu página de inicio de sesión.
# Dónde obtenerla: Déjala en /sign-in salvo que muevas la página.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Ruta de tu página de registro.
# Dónde obtenerla: Déjala en /sign-up salvo que muevas la página.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Destino tras iniciar sesión cuando no hay una redirección previa.
# Dónde obtenerla: Cualquier ruta de tu aplicación.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Destino tras registrarse cuando no hay una redirección previa.
# Dónde obtenerla: Cualquier ruta de tu aplicación.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── payments-mercadopago ──────────────────────────────
# Access token privado de Mercado Pago. Con credenciales de prueba (TEST-...) todo ocurre en sandbox. [SECRETA: solo servidor]
# Dónde obtenerla: Mercado Pago → Tus integraciones → tu aplicación → Credenciales de prueba (desarrollo) o de producción.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Clave secreta con la que Mercado Pago firma las notificaciones (cabecera x-signature). [SECRETA: solo servidor]
# Dónde obtenerla: Mercado Pago → Tus integraciones → tu aplicación → Webhooks → Configurar notificaciones → Clave secreta.
MERCADOPAGO_WEBHOOK_SECRET=

# ── payments-mercadopago-convex ───────────────────────
# Secreto compartido que protege las funciones de pagos de Convex (convex/payments.ts). Úsalo con el MISMO valor en .env.local y en el deployment de Convex (npx convex env set). [SECRETA: solo servidor]
# Dónde obtenerla: Valor largo aleatorio (p. ej. `openssl rand -hex 32`); en Convex: `npx convex env set CONVEX_PAYMENTS_SECRET <valor>`.
CONVEX_PAYMENTS_SECRET=

# ── extra-rate-limit ──────────────────────────────────
# URL REST de tu base Redis en Upstash. Obligatoria en producción para limitar solicitudes. [SECRETA: solo servidor]
# Dónde obtenerla: console.upstash.com → Redis → tu base → REST API.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io

# Token REST de Upstash (lectura/escritura). [SECRETA: solo servidor]
# Dónde obtenerla: console.upstash.com → Redis → tu base → REST API → Token.
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxx

# ── extra-resend ──────────────────────────────────────
# API key de Resend para enviar emails desde el servidor. [SECRETA: solo servidor]
# Dónde obtenerla: resend.com → API Keys → Create API Key (permiso "Sending access").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente de los emails. Debe pertenecer a un dominio verificado en Resend.
# Dónde obtenerla: Un dominio verificado en resend.com → Domains. Para pruebas: onboarding@resend.dev.
EMAIL_FROM=Mi App <no-reply@miapp.com>
